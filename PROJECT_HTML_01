<!DOCTYPE html>
<html>
<head>
    <title>Click Game</title>
    <style>
        body {
            text-align: center;
            font-family: Arial, sans-serif;
            margin-top: 100px;
        }

        button {
            font-size: 30px;
            padding: 20px 40px;
            cursor: pointer;
        }

        #score {
            font-size: 40px;
            margin: 20px;
        }
    </style>
</head>
<body>

    <h1>Click Game</h1>
    <div id="score">0</div>

    <button onclick="addPoint()">Click Me!</button>

    <script>
        let score = 0;

        function addPoint() {
            score++;
            document.getElementById("score").textContent = score;
        }
    </script>

</body>
</html>
